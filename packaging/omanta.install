post_install() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
  update-desktop-database -q >/dev/null 2>&1 || true
}

post_upgrade() {
  post_install
  # The file chooser arrived in 0.1.27; omanta-switch runs per user, so
  # point anyone upgrading past it at the one command that turns it on.
  if [ "$(vercmp "$2" 0.1.27)" -lt 0 ]; then
    echo "omanta can now be your Open/Save dialog: run 'omanta-switch omanta' to turn it on."
  fi
}

post_remove() {
  post_install
}
