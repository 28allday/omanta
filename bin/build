#!/usr/bin/env sh
# Configure and build omanta into build/. Extra arguments go to the build step,
# e.g. `./bin/build --target tst_theme`.
#
# OMANTA_BUILD_TYPE=Release ./bin/build  for a release-flavoured local build;
# the shipped package builds from the release tag through packaging/PKGBUILD.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build"
BUILD_TYPE="${OMANTA_BUILD_TYPE:-Debug}"

if ! command -v cmake >/dev/null 2>&1; then
  echo "cmake is required to build omanta." >&2
  exit 1
fi

if command -v ninja >/dev/null 2>&1; then
  cmake -S "$ROOT" -B "$BUILD_DIR" -G Ninja \
    -DCMAKE_BUILD_TYPE="$BUILD_TYPE" -DCMAKE_INSTALL_PREFIX=/usr
else
  cmake -S "$ROOT" -B "$BUILD_DIR" \
    -DCMAKE_BUILD_TYPE="$BUILD_TYPE" -DCMAKE_INSTALL_PREFIX=/usr
fi

cmake --build "$BUILD_DIR" "$@"

echo "Built $BUILD_DIR/omanta ($BUILD_TYPE)"
